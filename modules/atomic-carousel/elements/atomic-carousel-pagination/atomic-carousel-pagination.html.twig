{% import 'elementor/macros' as m %}
{% set i18n = carousel_i18n | default({}) %}
<div class="{{ m.render_base_classes(id, base_styles, settings, ['e-carousel__pagination'], 'div') }} {{ editor_classes | default('') }}"
	{{- ' ' }}{{ m.render_data_attributes(id, type, interaction_id) }}
	{{- ' ' }}{{ m.render_interactions(interactions) }}
	{{- ' ' }}aria-label="{{ i18n.pagination_aria_label | default('Slides') | e }}"
	{{- m.render_custom_attributes(settings, editor_attributes) }}><!-- elementor-children-placeholder --></div>
