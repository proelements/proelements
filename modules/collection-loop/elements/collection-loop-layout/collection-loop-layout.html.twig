{% import 'elementor/macros' as m %}
{%- set loop_context = loop_context | default({}) -%}
{%- set is_query_empty = loop_context.has_items is defined and loop_context.has_items is same as(false) -%}

<div class="{{ m.render_base_classes(id, base_styles, settings, ['e-default-div']) }} {{ editor_classes | default('') }}"
    id="e-collection-loop-layout-{{ id }}"
    role="list"
    {%- if is_query_empty %} style="display: none;"{% endif %}
    {{- ' ' }}{{ m.render_data_attributes(id, type, interaction_id) }}
    {{- m.render_custom_attributes(settings, editor_attributes) }}>
    <!-- elementor-children-placeholder -->
</div>
